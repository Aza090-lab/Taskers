<ul>
    <% tasks.forEach(t => { %>
        <li>
            <% if (t.completed == 1) {%>
                <h3 style="color: greenyellow;"><%= t.title %></h3>
            <% } %>
            <% if (t.completed == 0) {%>
                <h3 style="color: red;"><%= t.title %></h3>
            <% } %>

            <form action="/tasks/delete?_method=DELETE" method="POST"> 
                <input type="text" name="id" style="display: none;"" value=<%= t.id %>>
                <button type="submit" class="btn btn-outline-success"> Deletar </button> 
            </form>

            <form action="/tasks/complet" method="GET"> 
                <input type="text" name="id" style="display: none;"" value=<%= t.id %>>
                <button type="submit" class="btn btn-outline-success"> 🔄 </button> 
            </form>

            <form action="/tasks/changetitlemenu" method="GET"> 
                <input type="text" name="id" style="display: none;"" value=<%= t.id %>>
                <button type="submit" class="btn btn-outline-success"> ✏️ </button> 
            </form>
        </li>
    <% }) %>
</ul>