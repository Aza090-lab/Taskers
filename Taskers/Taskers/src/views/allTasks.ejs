<body>
    <form action="/tasks/task" method="GET"> <button type="submit" class="btn btn-outline-success" > 🔍 </button> </form>
    <input type="search" id="SearchTask">

    <ul>
        <% tasks.forEach(t => { %>
            <li>
                <h3><%= t.title %></h3>
                <p><%= t.completed %></p>
            </li>
        <% }) %>
    </ul>
</body>

