<%- include('partials/head') %> 
<%- include('partials/header') %>
<%- include('partials/navbar') %> 
    
    <main>
        <h2>Tarefas</h2>

        <div id="DisplayTasks">
        <% tasks.forEach(t => { %>
            <div>
                <li><ul>
                    <h3><%= t.title %></h3>
                    <p><%= t.completed %></p>
                    <button>Editar</button> <button>Deletar</button>
                </ul></li>
            </div>
        <% }) %>
        </div>
    </main>

